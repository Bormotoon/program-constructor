{
  "name": "program-constructor",
  "private": true,
  "version": "1.6.3",
  "type": "module",
  "description": "Конструктор рабочих программ по учебным предметам на основе федеральных рабочих программ (ФРП) 2025. Работает в браузере, без сервера и регистрации.",
  "keywords": [
    "education",
    "curriculum",
    "lesson-planner",
    "docx",
    "odt",
    "offline-first",
    "react",
    "frp",
    "fgos",
    "russian-school"
  ],
  "license": "MIT",
  "author": "Bormotoon",
  "homepage": "https://bormotoon.github.io/program-constructor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bormotoon/program-constructor.git"
  },
  "bugs": {
    "url": "https://github.com/Bormotoon/program-constructor/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "frp:parse": ".venv/bin/python tools/frp_parser.py $(grep -v '^#' tools/frp_sources.txt) -o build/frp --resume",
    "frp:content": ".venv/bin/python tools/frp_content.py $(grep -v '^#' tools/frp_sources.txt) -o build/frp-content",
    "frp:lessons": ".venv/bin/python tools/frp_lessons.py $(grep -v '^#' tools/frp_sources.txt) -o build/frp-lessons",
    "frp:reparse": ".venv/bin/python tools/reparse_stale.py",
    "frp:build": ".venv/bin/python tools/frp_orders.py && .venv/bin/python tools/build_frp_data.py",
    "frp:check": "python3 tools/check_frp_data.py",
    "verify:export": "esbuild tools/verify_export.ts --bundle --platform=node --format=esm --outfile=build/verify_export.mjs --log-level=error --external:docx && node build/verify_export.mjs",
    "verify:import": "esbuild tools/verify_import.ts --bundle --platform=node --format=esm --outfile=build/verify_import.mjs --log-level=error && node build/verify_import.mjs",
    "ui:check": "vite build && (vite preview --port 4180 --host 127.0.0.1 & SRV=$!; sleep 6; node tools/ui_check.mjs; CODE=$?; kill $SRV 2>/dev/null; exit $CODE)",
    "ui:contrast": "python3 tools/check_contrast.py",
    "verify:school-year": "esbuild tools/verify_school_year.ts --bundle --platform=node --format=esm --outfile=build/verify_school_year.mjs --log-level=error && node build/verify_school_year.mjs",
    "build:schedule": "APP=schedule vite build",
    "dev:schedule": "APP=schedule vite --port=3001 --host=0.0.0.0",
    "build:all": "npm run build && npm run build:schedule && npm run build:techcard",
    "verify:schedule": "esbuild tools/verify_schedule.ts --bundle --platform=node --format=esm --outfile=build/verify_schedule.mjs --log-level=error --external:docx && node build/verify_schedule.mjs",
    "build:techcard": "APP=techcard vite build",
    "dev:techcard": "APP=techcard vite --port=3002 --host=0.0.0.0",
    "verify:techcard": "esbuild tools/verify_techcard.ts --bundle --platform=node --format=esm --outfile=build/verify_techcard.mjs --log-level=error --external:docx && node build/verify_techcard.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
