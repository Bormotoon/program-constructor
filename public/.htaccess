# Кэширование статики приложения.
#
# Хостинг по умолчанию отдаёт всё с max-age=2628000 (30 дней). Для файлов из
# assets/ это правильно — их имена содержат хеш содержимого, и при изменении
# меняется имя. А вот index.html так кэшировать нельзя: браузер месяц держит
# ссылки на чанки, которых после следующего выката уже нет, и приложение
# ломается на любой ленивой загрузке (28.07.2026 так и вышло).

<IfModule mod_headers.c>
    # Оглавление сборки — всегда сверять с сервером.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Expires
    </FilesMatch>

    # Хешированные ассеты неизменяемы: их можно кэшировать сколь угодно долго.
    <FilesMatch "\.(js|css|woff2?|svg|png|webp|json)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
